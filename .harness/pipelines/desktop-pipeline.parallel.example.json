{
  "schema_version": "1.0",
  "pipeline": "desktop-parallel",
  "stages": [
    {
      "id": "analysis",
      "description": "需求拆解并输出两个独立子任务 scope",
      "role": "analyst",
      "depends_on": [],
      "write_scope": [
        ".harness/state/tasks"
      ],
      "gate": "script/check.ps1",
      "max_attempts": 1,
      "outputs": [
        "scope_a",
        "scope_b"
      ]
    },
    {
      "id": "coding-a",
      "description": "实现子任务 A 的代码、配置和测试",
      "role": "coder",
      "depends_on": [
        "analysis"
      ],
      "write_scope": [
        "src/module-a"
      ],
      "gate": "script/check.ps1 -Compile",
      "max_attempts": 2,
      "outputs": [
        "code_a"
      ]
    },
    {
      "id": "coding-b",
      "description": "实现子任务 B 的代码、配置和测试",
      "role": "coder",
      "depends_on": [
        "analysis"
      ],
      "write_scope": [
        "src/module-b"
      ],
      "gate": "script/check.ps1 -Compile",
      "max_attempts": 2,
      "outputs": [
        "code_b"
      ]
    },
    {
      "id": "test",
      "description": "汇总两个子任务并运行集成测试",
      "role": "tester",
      "depends_on": [
        "coding-a",
        "coding-b"
      ],
      "write_scope": [
        "src/test"
      ],
      "gate": "script/check.ps1 -Backend",
      "max_attempts": 2,
      "outputs": [
        "test_report"
      ]
    },
    {
      "id": "review",
      "description": "独立评审并输出 pass/rework/needs_owner",
      "role": "reviewer",
      "depends_on": [
        "test"
      ],
      "write_scope": [],
      "gate": "script/check.ps1",
      "max_attempts": 1,
      "max_rework": 2,
      "outputs": [
        "review_verdict"
      ]
    }
  ]
}
